<Window x:Class="PDMTools.IgpBomCompareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="iGP BOM 比對結果"
        Height="640"
        Width="980"
        MinHeight="420"
        MinWidth="720"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="IgpFilterHeaderButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Padding" Value="2,0,2,0" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Height" Value="18" />
            <Setter Property="MinWidth" Value="18" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>

        <Style x:Key="IgpCompareDataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding Title}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                            <Button Grid.Column="1"
                                    Tag="{Binding Key}"
                                    Click="IgpCompareColumnFilterButton_OnClick">
                                <Button.Content>
                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               Text="&#xE71C;"
                                               FontSize="11" />
                                </Button.Content>
                                <Button.Style>
                                    <Style BasedOn="{StaticResource IgpFilterHeaderButtonStyle}" TargetType="Button">
                                        <Setter Property="Foreground" Value="DimGray" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFiltered}" Value="True">
                                                <Setter Property="Foreground" Value="#FF1565C0" />
                                                <Setter Property="FontWeight" Value="Bold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 預設深灰；Only* 紅／藍；Mismatch＝兩邊都有但數量不一致→綠 -->
        <Style x:Key="IgpCompareDataGridRowStyle" TargetType="DataGridRow">
            <Setter Property="Foreground" Value="#FF212121" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DiffType}" Value="OnlyPDM">
                    <Setter Property="Foreground" Value="#FFC62828" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DiffType}" Value="OnlyiGP">
                    <Setter Property="Foreground" Value="#FF1565C0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DiffType}" Value="Mismatch">
                    <Setter Property="Foreground" Value="#FF2E7D32" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DiffType}" Value="OnlyPDMEdge">
                    <Setter Property="Foreground" Value="#FFC62828" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DiffType}" Value="OnlyiGPEdge">
                    <Setter Property="Foreground" Value="#FF1565C0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="SummaryText"
                       Grid.Column="0"
                       TextWrapping="Wrap"
                       Foreground="DimGray"
                       FontSize="12" />
            <Button x:Name="SaveResultButton"
                    Grid.Column="1"
                    Width="108"
                    Height="28"
                    Margin="12,0,0,0"
                    VerticalAlignment="Top"
                    Content="儲存結果…"
                    Click="SaveResultButton_OnClick"
                    ToolTip="將完整比對結果匯出為 Excel（建議）或 JSON；內容為全部列，不受欄位篩選影響。Excel 為「表格」格式並套用與視窗相同之列文字顏色。" />
        </Grid>

        <TabControl x:Name="MainTabControl"
                    Grid.Row="1"
                    SelectionChanged="MainTabControl_OnSelectionChanged">
            <TabItem Header="Stage1：料號彙總">
                <DataGrid x:Name="Stage1Grid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="All"
                          Margin="0,8,0,0"
                          AlternationCount="2"
                          RowBackground="White"
                          AlternatingRowBackground="#FFF5F5F5"
                          RowStyle="{StaticResource IgpCompareDataGridRowStyle}" />
            </TabItem>
            <TabItem Header="Stage2：父子結構">
                <DataGrid x:Name="Stage2Grid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="All"
                          Margin="0,8,0,0"
                          AlternationCount="2"
                          RowBackground="White"
                          AlternatingRowBackground="#FFF5F5F5"
                          RowStyle="{StaticResource IgpCompareDataGridRowStyle}" />
            </TabItem>
        </TabControl>

        <Border Grid.Row="2"
                Background="#FFF5F5F5"
                BorderBrush="#FFE0E0E0"
                BorderThickness="0,1,0,0"
                Padding="10,8"
                Margin="0,8,0,0">
            <TextBlock x:Name="DisplayStatsTextBlock"
                       TextWrapping="Wrap"
                       FontSize="12"
                       Foreground="#FF424242" />
        </Border>
    </Grid>
</Window>
