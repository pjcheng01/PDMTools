<Window x:Class="PDMTools.BatchDrawingPdfWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="工程圖批次匯出 PDF"
        Height="520" Width="720" MinHeight="360" MinWidth="560"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" MinHeight="160" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock x:Name="SummaryTextBlock"
               Grid.Row="0"
               Margin="0,0,0,10"
               TextWrapping="Wrap"
               Foreground="#FF6B7280" />

    <Grid Grid.Row="1" Margin="0,0,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBox x:Name="OutputFolderTextBox"
               Grid.Column="0"
               Height="28"
               Margin="0,0,8,0"
               VerticalContentAlignment="Center" />
      <Button Grid.Column="1" Width="100" Height="28" Click="BrowseOutputFolder_OnClick">
        <StackPanel Orientation="Horizontal">
          <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xED25;" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
          <TextBlock Text="瀏覽…" VerticalAlignment="Center"/>
        </StackPanel>
      </Button>
    </Grid>

    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
      <Button x:Name="StartButton" Width="110" Height="30" Click="Start_OnClick">
        <StackPanel Orientation="Horizontal">
          <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE768;" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
          <TextBlock Text="開始" VerticalAlignment="Center"/>
        </StackPanel>
      </Button>
      <Button x:Name="CancelButton" Width="110" Height="30" Margin="10,0,0,0" IsEnabled="False" Click="Cancel_OnClick">
        <StackPanel Orientation="Horizontal">
          <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE711;" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
          <TextBlock Text="取消" VerticalAlignment="Center"/>
        </StackPanel>
      </Button>
      <ProgressBar x:Name="BatchProgressBar"
                   Width="220"
                   Height="22"
                   Margin="16,0,0,0"
                   Minimum="0"
                   Maximum="100"
                   Value="0" />
      <CheckBox x:Name="OpenPdfCheckBox"
                Margin="16,0,0,0"
                VerticalAlignment="Center"
                Content="完成後檢視 PDF"
                IsChecked="True" />
    </StackPanel>

    <Border Grid.Row="3"
            Margin="0,0,0,10"
            BorderBrush="#FFE5E7EB"
            BorderThickness="1"
            CornerRadius="6">
      <TextBox x:Name="LogTextBox"
               IsReadOnly="True"
               AcceptsReturn="True"
               TextWrapping="Wrap"
               VerticalScrollBarVisibility="Auto"
               HorizontalScrollBarVisibility="Auto"
               FontFamily="Consolas"
               FontSize="11"
               BorderThickness="0" />
    </Border>

    <Border Grid.Row="4"
            Background="#FFF3F4F6"
            BorderBrush="#FFE5E7EB"
            BorderThickness="1"
            CornerRadius="8"
            Margin="0,6,0,0"
            Padding="10,6">
      <TextBlock x:Name="FooterTextBlock"
                 Foreground="#FF6B7280"
                 FontSize="11"
                 TextWrapping="Wrap" />
    </Border>
  </Grid>
</Window>
