<Window x:Class="PDMTools.DrawingSheetFormatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="工程圖圖頁格式路徑"
        Height="600"
        Width="940"
        MinHeight="420"
        MinWidth="680"
        WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <Style x:Key="ReportFilterHeaderButtonStyle" TargetType="Button">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Padding" Value="2,0,2,0" />
      <Setter Property="Margin" Value="4,0,0,0" />
      <Setter Property="Height" Value="18" />
      <Setter Property="MinWidth" Value="18" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

    <Style x:Key="ReportVaultDataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="ContentTemplate">
        <Setter.Value>
          <DataTemplate>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0"
                         Text="{Binding Title}"
                         VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" />
              <Button Grid.Column="1"
                      Tag="{Binding Key}"
                      Click="ColumnFilterButton_OnClick">
                <Button.Content>
                  <TextBlock FontFamily="Segoe MDL2 Assets"
                             FontSize="11"
                             Text="&#xE71C;" />
                </Button.Content>
                <Button.Style>
                  <Style BasedOn="{StaticResource ReportFilterHeaderButtonStyle}" TargetType="Button">
                    <Setter Property="Foreground" Value="DimGray" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsFiltered}" Value="True">
                        <Setter Property="Foreground" Value="#FF1565C0" />
                        <Setter Property="FontWeight" Value="Bold" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
              </Button>
            </Grid>
          </DataTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" MinHeight="180" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock x:Name="SummaryTextBlock"
               Grid.Row="0"
               Margin="0,0,0,10"
               TextWrapping="Wrap"
               Foreground="DimGray" />

    <StackPanel Grid.Row="1"
                Orientation="Horizontal"
                Margin="0,0,0,8">
      <Button x:Name="StartButton"
              Width="100"
              Height="30"
              Content="開始查詢"
              Click="Start_OnClick" />
      <Button x:Name="CancelButton"
              Width="100"
              Height="30"
              Margin="10,0,0,0"
              Content="取消"
              IsEnabled="False"
              Click="Cancel_OnClick" />
      <ProgressBar x:Name="BatchProgressBar"
                   Width="220"
                   Height="22"
                   Margin="16,0,0,0"
                   Minimum="0"
                   Maximum="100"
                   Value="0" />
      <TextBlock x:Name="ProgressText"
                 Margin="10,0,0,0"
                 VerticalAlignment="Center"
                 Foreground="DimGray" />
      <TextBlock x:Name="ResultFilterCountTextBlock"
                 Margin="16,0,8,0"
                 VerticalAlignment="Center"
                 Foreground="DimGray"
                 FontSize="11"
                 MinWidth="96"
                 TextAlignment="Right" />
      <Button Width="96"
              Height="26"
              Content="清除欄篩選"
              VerticalAlignment="Center"
              ToolTip="清除所有欄位的漏斗篩選（與主視窗 Vault BOM 相同）。"
              Click="ClearColumnFilters_OnClick" />
    </StackPanel>

    <Grid Grid.Row="2"
          Margin="0,0,0,8">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <TextBlock Grid.Row="0"
                 Grid.Column="0"
                 VerticalAlignment="Center"
                 Margin="0,0,8,6"
                 Text="圖頁格式範本" />
      <TextBox x:Name="SheetFormatTemplatePathTextBox"
               Grid.Row="0"
               Grid.Column="1"
               Margin="0,0,8,6"
               VerticalAlignment="Center"
               MinHeight="24"
               ToolTip="本機 .slddrt 完整路徑；套用時會 check out 工程圖並寫入各勾選圖頁後存檔。" />
      <Button Grid.Row="0"
              Grid.Column="2"
              Width="72"
              Height="26"
              Margin="0,0,0,6"
              Content="瀏覽…"
              Click="BrowseSheetFormatTemplate_OnClick" />

      <StackPanel Grid.Row="1"
                  Grid.Column="0"
                  Grid.ColumnSpan="3"
                  Orientation="Horizontal">
        <Button x:Name="ApplySheetFormatButton"
                Width="120"
                Height="28"
                Content="套用至勾選列"
                Click="ApplySheetFormat_OnClick" />
        <Button Width="100"
                Height="28"
                Margin="10,0,0,0"
                Content="全選可見列"
                Click="SelectAllVisibleRows_OnClick" />
        <Button Width="120"
                Height="28"
                Margin="10,0,0,0"
                Content="取消勾選可見列"
                Click="ClearVisibleSelection_OnClick" />
      </StackPanel>
    </Grid>

    <DataGrid x:Name="ResultDataGrid"
              Grid.Row="3"
              AutoGenerateColumns="False"
              ColumnHeaderStyle="{StaticResource ReportVaultDataGridColumnHeaderStyle}"
              IsReadOnly="False"
              CanUserAddRows="False"
              CanUserSortColumns="True"
              CanUserReorderColumns="True"
              CanUserResizeColumns="True"
              HeadersVisibility="Column"
              RowHeaderWidth="0"
              GridLinesVisibility="Horizontal"
              AlternatingRowBackground="#F7F7F7"
              FontSize="12"
              SelectionMode="Single" />

    <TextBlock x:Name="FooterTextBlock"
               Grid.Row="4"
               Margin="0,8,0,0"
               Foreground="DimGray"
               FontSize="11"
               TextWrapping="Wrap" />
  </Grid>
</Window>
