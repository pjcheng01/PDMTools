<Window x:Class="PDMTools.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PDMTools - BOM Exporter"
        Height="560"
        Width="920"
        MinHeight="400"
        MinWidth="720"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" MinHeight="120" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>

    <TextBlock Grid.Row="0"
               Grid.ColumnSpan="2"
               Margin="0,0,0,8"
               Text="請選擇 C:\CP-PDM 底下的組合件 (.sldasm)" />

    <TextBox x:Name="AssemblyPathTextBox"
             Grid.Row="1"
             Grid.Column="0"
             Height="30"
             Margin="0,0,8,0"
             VerticalContentAlignment="Center"
             IsReadOnly="True" />

    <Button x:Name="BrowseButton"
            Grid.Row="1"
            Grid.Column="1"
            Width="88"
            Height="30"
            Content="瀏覽"
            Click="BrowseButton_OnClick" />

    <StackPanel Grid.Row="2"
                Grid.ColumnSpan="2"
                Margin="0,14,0,0"
                Orientation="Horizontal">
      <Button x:Name="StartGrabButton"
              Width="120"
              Height="32"
              Content="開始抓取"
              Click="StartGrabButton_OnClick" />
      <Button x:Name="ExportButton"
              Width="120"
              Height="32"
              Margin="10,0,0,0"
              Content="匯出 xlsx"
              Click="ExportButton_OnClick" />
      <Button x:Name="ColumnSettingsButton"
              Width="120"
              Height="32"
              Margin="10,0,0,0"
              Content="設定欄位..."
              Click="ColumnSettingsButton_OnClick" />
      <ToggleButton x:Name="ShowDrawingsToggle"
                    Width="120"
                    Height="32"
                    Margin="10,0,0,0"
                    Content="顯示工程圖"
                    IsEnabled="False"
                    Click="ShowDrawingsToggle_Click" />
      <ProgressBar x:Name="ProgressBar"
                   Width="220"
                   Height="20"
                   Margin="12,6,0,0"
                   Minimum="0"
                   Maximum="100" />
    </StackPanel>

    <TextBlock x:Name="StatusTextBlock"
               Grid.Row="3"
               Grid.ColumnSpan="2"
               Margin="0,10,0,8"
               TextWrapping="Wrap"
               Foreground="DimGray"
               Text="就緒" />

    <!-- 欄位多時以橫向捲軸瀏覽；列多時以縱向捲軸（DataGrid 內建） -->
    <DataGrid x:Name="BomDataGrid"
              Grid.Row="4"
              Grid.ColumnSpan="2"
              MinHeight="200"
              Margin="0,0,0,0"
              IsReadOnly="True"
              AutoGenerateColumns="False"
              CanUserAddRows="False"
              CanUserDeleteRows="False"
              SelectionMode="Extended"
              HeadersVisibility="Column"
              GridLinesVisibility="All"
              HorizontalGridLinesBrush="#FFD8D8D8"
              VerticalGridLinesBrush="#FFD8D8D8"
              AlternatingRowBackground="#FFF5F5F5"
              EnableRowVirtualization="True"
              EnableColumnVirtualization="True"
              ScrollViewer.HorizontalScrollBarVisibility="Auto"
              ScrollViewer.VerticalScrollBarVisibility="Auto"
              ScrollViewer.CanContentScroll="True">
      <!-- 工程圖列（IsDrawing=True）以淡藍色底色顯示 -->
      <DataGrid.RowStyle>
        <Style TargetType="DataGridRow">
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsDrawing}" Value="True">
              <Setter Property="Background" Value="#FFD6EEFF" />
              <Setter Property="Foreground" Value="#FF003070" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </DataGrid.RowStyle>
      <!-- 欄位於程式碼中建立，與 Excel 匯出一致 -->
    </DataGrid>
  </Grid>
</Window>
