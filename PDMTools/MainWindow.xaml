<Window x:Class="PDMTools.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PDMTools — Vault BOM 工具"
        Height="620"
        Width="980"
        MinHeight="480"
        MinWidth="780"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>

    <!-- ════════════════════════════════════════════
         圓角 ControlTemplate — Button
    ════════════════════════════════════════════ -->
    <ControlTemplate x:Key="RoundedButtonTemplate" TargetType="Button">
      <Border x:Name="Bd"
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}"
              CornerRadius="6"
              Padding="{TemplateBinding Padding}"
              SnapsToDevicePixels="True">
        <ContentPresenter HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          RecognizesAccessKey="True" />
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter TargetName="Bd" Property="Background" Value="#FFEEF0F3" />
          <Setter TargetName="Bd" Property="BorderBrush" Value="#FFB0BEC5" />
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Setter TargetName="Bd" Property="Background" Value="#FFD6DAE0" />
        </Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0.5" />
        </Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- ── 圓角 ControlTemplate — ToggleButton ── -->
    <ControlTemplate x:Key="RoundedToggleButtonTemplate" TargetType="ToggleButton">
      <Border x:Name="Bd"
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}"
              CornerRadius="6"
              Padding="{TemplateBinding Padding}"
              SnapsToDevicePixels="True">
        <ContentPresenter HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          RecognizesAccessKey="True" />
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsChecked" Value="True">
          <Setter TargetName="Bd" Property="Background" Value="#FFE8EAF6" />
          <Setter TargetName="Bd" Property="BorderBrush" Value="#FF5C6BC0" />
        </Trigger>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter TargetName="Bd" Property="Background" Value="#FFEEF0F3" />
          <Setter TargetName="Bd" Property="BorderBrush" Value="#FFB0BEC5" />
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Setter TargetName="Bd" Property="Background" Value="#FFD6DAE0" />
        </Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0.5" />
        </Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- ── 欄位篩選漏斗按鈕（小型，不套圓角 Template）── -->
    <Style x:Key="FilterHeaderButtonStyle" TargetType="Button">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Padding" Value="2,0,2,0" />
      <Setter Property="Margin" Value="4,0,0,0" />
      <Setter Property="Height" Value="18" />
      <Setter Property="MinWidth" Value="18" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

    <Style x:Key="BomDataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="ContentTemplate">
        <Setter.Value>
          <DataTemplate>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0"
                         Text="{Binding Title}"
                         VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" />
              <Button Grid.Column="1"
                      Tag="{Binding Key}"
                      Click="ColumnFilterButton_OnClick">
                <Button.Content>
                  <TextBlock FontFamily="Segoe MDL2 Assets"
                             Text="&#xE71C;"
                             FontSize="11" />
                </Button.Content>
                <Button.Style>
                  <Style BasedOn="{StaticResource FilterHeaderButtonStyle}" TargetType="Button">
                    <Setter Property="Foreground" Value="DimGray" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsFiltered}" Value="True">
                        <Setter Property="Foreground" Value="#FF1565C0" />
                        <Setter Property="FontWeight" Value="Bold" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
              </Button>
            </Grid>
          </DataTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ── 功能區 GroupBox（圓角自訂 Template）── -->
    <Style x:Key="SectionGroupBoxStyle" TargetType="GroupBox">
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="Padding" Value="8,6,8,6" />
      <Setter Property="BorderBrush" Value="#FFCDD1D6" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="White" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="GroupBox">
            <Border BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Background="{TemplateBinding Background}"
                    CornerRadius="8"
                    SnapsToDevicePixels="True">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!-- 標題列 -->
                <Border Grid.Row="0"
                        Background="#FFF3F4F6"
                        CornerRadius="8,8,0,0"
                        Padding="8,3,8,4"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="0,0,0,1">
                  <ContentPresenter ContentSource="Header"
                                    RecognizesAccessKey="True" />
                </Border>
                <!-- 內容 -->
                <ContentPresenter Grid.Row="1"
                                  Margin="{TemplateBinding Padding}" />
              </Grid>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Setter Property="HeaderTemplate">
        <Setter.Value>
          <DataTemplate>
            <TextBlock Text="{Binding}"
                       FontSize="10"
                       Foreground="#FF6B7280"
                       FontWeight="SemiBold" />
          </DataTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ── 工具列按鈕（圓角）── -->
    <Style x:Key="ToolBarButtonStyle" TargetType="Button">
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="MinWidth" Value="80" />
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#FFD1D5DB" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Template" Value="{StaticResource RoundedButtonTemplate}" />
    </Style>

    <!-- ── 小型按鈕（路徑列、快照、重新載入等）── -->
    <Style x:Key="SmallButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#FFD1D5DB" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Template" Value="{StaticResource RoundedButtonTemplate}" />
    </Style>

    <!-- ── ToggleButton 圓角樣式 ── -->
    <Style x:Key="RoundedToggleButtonStyle" TargetType="ToggleButton">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#FFD1D5DB" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Template" Value="{StaticResource RoundedToggleButtonTemplate}" />
    </Style>

    <!-- ── 全域 TextBox 圓角（自動套用）── -->
    <Style TargetType="{x:Type TextBox}">
      <Setter Property="BorderBrush" Value="#FFD1D5DB" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type TextBox}">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="5"
                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
              <ScrollViewer x:Name="PART_ContentHost"
                            Padding="{TemplateBinding Padding}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            Focusable="False" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.6" />
                <Setter TargetName="Bd" Property="Background" Value="#FFF9FAFB" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF9CA3AF" />
              </Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF6366F1" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />  <!-- 0: Vault 選擇列 -->
      <RowDefinition Height="Auto" />  <!-- 1: 檔案路徑列 -->
      <RowDefinition Height="Auto" />  <!-- 2: 模式選擇 + 快照 -->
      <RowDefinition Height="Auto" />  <!-- 3: 功能工具列 -->
      <RowDefinition Height="*"    />  <!-- 4: 資料表格區 -->
      <RowDefinition Height="Auto" />  <!-- 5: 狀態列 -->
    </Grid.RowDefinitions>

    <!-- ══════════════════════════════════════════════
         Row 0 — Vault 選擇列
    ══════════════════════════════════════════════ -->
    <Border Grid.Row="0"
            Margin="12,10,12,0"
            Background="#FFF0F9FF"
            BorderBrush="#FFB0D4F0"
            BorderThickness="1"
            CornerRadius="4"
            Padding="10,5">
      <DockPanel>
        <TextBlock Text="Vault："
                   VerticalAlignment="Center"
                   Foreground="#FF1E40AF"
                   FontWeight="SemiBold"
                   Margin="0,0,8,0" />

        <Button x:Name="RefreshVaultListButton"
                DockPanel.Dock="Right"
                Height="26"
                Padding="8,0"
                Style="{StaticResource SmallButtonStyle}"
                Click="RefreshVaultListButton_OnClick"
                ToolTip="重新掃描本機已安裝的 Vault 清單">
          <StackPanel Orientation="Horizontal">
            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72C;" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
            <TextBlock Text="重新整理" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>

        <ComboBox x:Name="VaultComboBox"
                  Height="26"
                  Margin="0,0,6,0"
                  VerticalContentAlignment="Center"
                  DisplayMemberPath="DisplayText"
                  SelectionChanged="VaultComboBox_OnSelectionChanged"
                  ToolTip="選擇要使用的本機 Vault（點擊「重新整理」以掃描已安裝的 Vault）" />
      </DockPanel>
    </Border>

    <!-- ══════════════════════════════════════════════
         Row 1 — 檔案路徑列
    ══════════════════════════════════════════════ -->
    <Grid Grid.Row="1" Margin="12,8,12,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <TextBlock Grid.Column="0"
                 Text="組合件路徑："
                 VerticalAlignment="Center"
                 Foreground="#FF374151"
                 FontWeight="SemiBold"
                 Margin="0,0,8,0" />

      <TextBox x:Name="AssemblyPathTextBox"
               Grid.Column="1"
               Height="30"
               Margin="0,0,6,0"
               VerticalContentAlignment="Center"
               ToolTip="請選擇 .sldasm 組合件檔案路徑"
               TextChanged="AssemblyPathTextBox_OnTextChanged" />

      <Button x:Name="BrowseButton"
              Grid.Column="2"
              Height="30"
              Padding="12,0"
              Margin="0,0,6,0"
              Style="{StaticResource SmallButtonStyle}"
              Click="BrowseButton_OnClick">
        <StackPanel Orientation="Horizontal">
          <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xED25;" FontSize="13" Margin="0,0,5,0" VerticalAlignment="Center"/>
          <TextBlock Text="開啟檔案" VerticalAlignment="Center"/>
        </StackPanel>
      </Button>

      <Button x:Name="RecentPathsButton"
              Grid.Column="3"
              Height="30"
              Padding="10,0"
              Style="{StaticResource SmallButtonStyle}"
              Click="RecentPathsButton_OnClick"
              ToolTip="顯示最近使用過的組合件路徑">
        <StackPanel Orientation="Horizontal">
          <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE81C;" FontSize="13" Margin="0,0,5,0" VerticalAlignment="Center"/>
          <TextBlock Text="最近使用" VerticalAlignment="Center"/>
        </StackPanel>
      </Button>
    </Grid>

    <!-- ══════════════════════════════════════════════
         Row 2 — 作業模式 + 快照
    ══════════════════════════════════════════════ -->
    <Border Grid.Row="2"
            Margin="12,8,12,0"
            Background="#FFF9FAFB"
            BorderBrush="#FFE5E7EB"
            BorderThickness="1"
            CornerRadius="4"
            Padding="10,6">
      <DockPanel>
        <TextBlock Text="作業模式："
                   VerticalAlignment="Center"
                   Foreground="#FF6B7280"
                   FontWeight="SemiBold"
                   Margin="0,0,10,0" />
        <RadioButton x:Name="BomModeRadioButton"
                     Content="Vault BOM"
                     IsChecked="True"
                     GroupName="MainMode"
                     VerticalAlignment="Center"
                     Margin="0,0,16,0"
                     Checked="MainModeRadioButton_OnChecked" />
        <RadioButton x:Name="ReferenceAuditModeRadioButton"
                     Content="參考稽核"
                     GroupName="MainMode"
                     VerticalAlignment="Center"
                     Checked="MainModeRadioButton_OnChecked" />

        <StackPanel DockPanel.Dock="Right"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
          <Button x:Name="SaveProjectButton"
                  Height="26"
                  Padding="10,0"
                  Margin="0,0,6,0"
                  Style="{StaticResource SmallButtonStyle}"
                  Click="SaveProjectButton_OnClick"
                  ToolTip="將目前畫面上的路徑、模式、表格資料與篩選狀態存成 JSON 快照。">
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74E;" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
              <TextBlock Text="儲存快照" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button x:Name="LoadProjectButton"
                  Height="26"
                  Padding="10,0"
                  Style="{StaticResource SmallButtonStyle}"
                  Click="LoadProjectButton_OnClick"
                  ToolTip="從 JSON 快照還原畫面（不需重新向 Vault／SolidWorks 抓取）。">
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8B7;" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
              <TextBlock Text="開啟快照" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ══════════════════════════════════════════════
         Row 3 — 功能工具列（三個分區）
    ══════════════════════════════════════════════ -->
    <Grid Grid.Row="3" Margin="12,8,12,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />   <!-- BOM 參數設定區 -->
        <RowDefinition Height="Auto" />   <!-- 主操作 + 匯出 + 進階 -->
      </Grid.RowDefinitions>

      <!-- ── BOM 參數設定區（僅 Vault BOM 模式顯示） ── -->
      <Border x:Name="BomParamPanel"
              Grid.Row="0"
              Background="#FFFFFBEB"
              BorderBrush="#FFFDE68A"
              BorderThickness="1"
              CornerRadius="4"
              Padding="10,5"
              Margin="0,0,0,6">
        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="⚙ BOM 參數設定"
                     FontWeight="SemiBold"
                     FontSize="11"
                     Foreground="#FF92400E"
                     VerticalAlignment="Center"
                     Margin="0,0,16,0" />

          <TextBlock Text="組態：" VerticalAlignment="Center" Foreground="#FF6B7280" Margin="0,0,4,0" />
          <ComboBox x:Name="ConfigComboBox"
                    Width="200" MinWidth="140"
                    Height="26"
                    Margin="0,0,6,0"
                    IsEditable="True"
                    IsTextSearchEnabled="True"
                    VerticalContentAlignment="Center"
                    SelectionChanged="ConfigComboBox_SelectionOrTextChanged"
                    ToolTip="選檔後由 PDM 讀取組態清單；可從清單選取，或直接輸入組態名稱。" />
          <Button x:Name="ReloadConfigurationsButton"
                  Height="26" Padding="8,0" Margin="0,0,14,0"
                  Style="{StaticResource SmallButtonStyle}"
                  Click="ReloadConfigurationsButton_OnClick"
                  ToolTip="依目前路徑向 PDM 重新讀取組態清單。">
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72C;" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
              <TextBlock Text="重新載入組態" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>

          <TextBlock Text="最大層數：" VerticalAlignment="Center" Foreground="#FF6B7280" Margin="0,0,4,0" />
          <TextBox x:Name="MaxBomDepthTextBox"
                   Width="48" Height="26" Text="3"
                   Margin="0,0,6,0"
                   VerticalContentAlignment="Center" />
          <CheckBox x:Name="AllBomDepthCheckBox"
                    Content="取所有層"
                    VerticalAlignment="Center"
                    Margin="0,0,14,0"
                    IsChecked="False"
                    Checked="DepthAllCheckBox_OnCheckedChanged"
                    Unchecked="DepthAllCheckBox_OnCheckedChanged" />

          <TextBlock Text="BOM 定義：" VerticalAlignment="Center" Foreground="#FF6B7280" Margin="0,0,4,0" />
          <ComboBox x:Name="BomLevelDefinitionComboBox"
                    Width="140" Height="26"
                    Margin="0,0,0,0"
                    SelectedIndex="1"
                    SelectionChanged="BomLevelDefinitionComboBox_OnSelectionChanged"
                    VerticalContentAlignment="Center">
            <ComboBoxItem Content="定義 A（含根節點）" />
            <ComboBoxItem Content="定義 B（不含根節點）" />
          </ComboBox>
        </WrapPanel>
      </Border>

      <!-- ── 操作按鈕列 ── -->
      <WrapPanel x:Name="BomOperationsPanel"
                 Grid.Row="1"
                 Orientation="Horizontal">

        <!-- 【抓取】 -->
        <GroupBox Header="抓取" Style="{StaticResource SectionGroupBoxStyle}">
          <StackPanel Orientation="Horizontal">
            <Button x:Name="StartGrabButton"
                    Style="{StaticResource ToolBarButtonStyle}"
                    Click="StartGrabButton_OnClick">
              <StackPanel Orientation="Horizontal">
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE896;" FontSize="13" Margin="0,0,5,0" VerticalAlignment="Center"/>
                <TextBlock Text="開始抓取" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <ToggleButton x:Name="ShowDrawingsToggle"
                          Height="30" Padding="10,0" Margin="0,0,0,0"
                          IsEnabled="False"
                          Style="{StaticResource RoundedToggleButtonStyle}"
                          Click="ShowDrawingsToggle_Click"
                          ToolTip="切換顯示／隱藏工程圖列（.SLDDRW）">
              <StackPanel Orientation="Horizontal">
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8A1;" FontSize="13" Margin="0,0,5,0" VerticalAlignment="Center"/>
                <TextBlock Text="顯示工程圖" VerticalAlignment="Center"/>
              </StackPanel>
            </ToggleButton>
          </StackPanel>
        </GroupBox>

        <!-- 【篩選】 -->
        <GroupBox Header="篩選" Style="{StaticResource SectionGroupBoxStyle}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="快速篩選："
                       VerticalAlignment="Center"
                       Foreground="#FF6B7280"
                       Margin="0,0,5,0" />
            <ComboBox x:Name="QuickFilterComboBox"
                      Width="280" Height="26"
                      Margin="0,0,8,0"
                      VerticalContentAlignment="Center"
                      SelectionChanged="QuickFilterComboBox_OnSelectionChanged"
                      ToolTip="選擇快速篩選條件，即時套用於表格。" />
            <Button x:Name="ClearFiltersButton"
                    Height="30" Padding="10,0"
                    Style="{StaticResource SmallButtonStyle}"
                    Click="ClearFiltersButton_OnClick"
                    IsEnabled="False"
                    ToolTip="清除所有欄位篩選與快速篩選條件">
              <StackPanel Orientation="Horizontal">
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE711;" FontSize="13" Margin="0,0,5,0" VerticalAlignment="Center"/>
                <TextBlock Text="清除篩選" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </GroupBox>

        <!-- 【匯出】 -->
        <GroupBox Header="匯出" Style="{StaticResource SectionGroupBoxStyle}">
          <StackPanel Orientation="Horizontal">
            <Button x:Name="ExportButton"
                    Style="{StaticResource ToolBarButtonStyle}"
                    Click="ExportButton_OnClick"
                    ToolTip="匯出全部 BOM 資料（不受篩選影響）。">
              <StackPanel Orientation="Horizontal">
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8DE;" FontSize="13" Margin="0,0,5,0" VerticalAlignment="Center"/>
                <TextBlock Text="匯出全部" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button x:Name="ExportFilteredButton"
                    Style="{StaticResource ToolBarButtonStyle}"
                    MinWidth="110"
                    Click="ExportFilteredButton_OnClick"
                    IsEnabled="False"
                    ToolTip="僅匯出目前表格篩選後可見的資料列。">
              <StackPanel Orientation="Horizontal">
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8DE;" FontSize="13" Margin="0,0,5,0" VerticalAlignment="Center"/>
                <TextBlock Text="匯出篩選結果" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button x:Name="ColumnSettingsButton"
                    Style="{StaticResource ToolBarButtonStyle}"
                    Click="ColumnSettingsButton_OnClick"
                    ToolTip="設定要顯示的欄位與資料卡變數">
              <StackPanel Orientation="Horizontal">
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" FontSize="13" Margin="0,0,5,0" VerticalAlignment="Center"/>
                <TextBlock Text="欄位設定" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </GroupBox>

        <!-- 【進階功能】 -->
        <GroupBox Header="進階功能" Style="{StaticResource SectionGroupBoxStyle}">
          <WrapPanel Orientation="Horizontal">
            <Button x:Name="CompareIgpBomButton"
                    Style="{StaticResource ToolBarButtonStyle}"
                    Click="CompareIgpBomButton_OnClick"
                    ToolTip="匯入 iGP BOM（BOMMI02.xlsx／.xlsm／.csv）與目前 Vault BOM 做差異比對。">
              <StackPanel Orientation="Horizontal">
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE87D;" FontSize="13" Margin="0,0,5,0" VerticalAlignment="Center"/>
                <TextBlock Text="比對 iGP BOM" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <StackPanel Orientation="Horizontal" Margin="0,0,8,0" VerticalAlignment="Center">
              <TextBlock Text="比對階數：" VerticalAlignment="Center" Foreground="#FF6B7280" Margin="0,0,4,0" FontSize="11" />
              <ComboBox x:Name="IgpBomCompareDepthComboBox"
                        Width="62" Height="26"
                        SelectedIndex="1"
                        VerticalContentAlignment="Center"
                        ToolTip="比對時納入的階層深度上限（2～4 階）。">
                <ComboBoxItem Tag="2" Content="2 階" />
                <ComboBoxItem Tag="3" Content="3 階" />
                <ComboBoxItem Tag="4" Content="4 階" />
              </ComboBox>
            </StackPanel>

            <Button x:Name="BatchWorkflowTransitionButton"
                    Style="{StaticResource ToolBarButtonStyle}"
                    Click="BatchWorkflowTransitionButton_OnClick"
                    ToolTip="依目前篩選後可見之列，以 PDM 工作流程狀態分組並批次轉換狀態。">
              <StackPanel Orientation="Horizontal">
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8AB;" FontSize="13" Margin="0,0,5,0" VerticalAlignment="Center"/>
                <TextBlock Text="批次轉狀態" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button x:Name="BatchDrawingPdfButton"
                    Style="{StaticResource ToolBarButtonStyle}"
                    Click="BatchDrawingPdfButton_OnClick"
                    ToolTip="僅處理目前篩選後可見之工程圖列：取檔、重建、匯出 PDF 至指定資料夾。">
              <StackPanel Orientation="Horizontal">
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xEA90;" FontSize="13" Margin="0,0,5,0" VerticalAlignment="Center"/>
                <TextBlock Text="工程圖 PDF" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button x:Name="CustomPropTemplateButton"
                    Style="{StaticResource ToolBarButtonStyle}"
                    Click="CustomPropTemplateButton_OnClick"
                    ToolTip="查詢目前篩選後可見之 SolidWorks 檔案所套用的自訂屬性範本。">
              <StackPanel Orientation="Horizontal">
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE9D9;" FontSize="13" Margin="0,0,5,0" VerticalAlignment="Center"/>
                <TextBlock Text="自訂屬性" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button x:Name="DrawingSheetFormatButton"
                    Style="{StaticResource ToolBarButtonStyle}"
                    Click="DrawingSheetFormatButton_OnClick"
                    ToolTip="查詢工程圖各圖頁格式路徑；可套用 .slddrt 格式。">
              <StackPanel Orientation="Horizontal">
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8C4;" FontSize="13" Margin="0,0,5,0" VerticalAlignment="Center"/>
                <TextBlock Text="圖頁格式" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </WrapPanel>
        </GroupBox>

      </WrapPanel>
    </Grid>

    <!-- ══════════════════════════════════════════════
         Row 4 — 資料表格區
    ══════════════════════════════════════════════ -->
    <Grid Grid.Row="4" Margin="12,8,12,0">

      <!-- Vault BOM 模式 -->
      <Grid x:Name="BomModeContentPanel" Visibility="Visible">
        <Border BorderBrush="#FFE5E7EB"
                BorderThickness="1"
                CornerRadius="8"
                ClipToBounds="True">
        <DataGrid x:Name="BomDataGrid"
                  IsReadOnly="True"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Extended"
                  HeadersVisibility="Column"
                  GridLinesVisibility="All"
                  HorizontalGridLinesBrush="#FFE5E7EB"
                  VerticalGridLinesBrush="#FFE5E7EB"
                  AlternationCount="2"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="True"
                  BorderThickness="0"
                  ColumnHeaderStyle="{StaticResource BomDataGridColumnHeaderStyle}"
                  Sorting="BomDataGrid_OnSorting"
                  PreviewMouseRightButtonDown="BomDataGrid_OnPreviewMouseRightButtonDown"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  ScrollViewer.CanContentScroll="True">
          <DataGrid.RowStyle>
            <Style TargetType="DataGridRow">
              <Setter Property="Background" Value="White" />
              <Style.Triggers>
                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                  <Setter Property="Background" Value="#FFF9FAFB" />
                </Trigger>
                <DataTrigger Binding="{Binding IsDrawing}" Value="True">
                  <Setter Property="Background" Value="#FFD6EEFF" />
                  <Setter Property="Foreground" Value="#FF003070" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </DataGrid.RowStyle>
          <DataGrid.ContextMenu>
            <ContextMenu>
              <MenuItem Header="複製儲存格" Click="CopyCurrentCellMenuItem_OnClick" />
              <MenuItem Header="選取文字模式" Click="OpenTextSelectionModeMenuItem_OnClick" />
            </ContextMenu>
          </DataGrid.ContextMenu>
        </DataGrid>
        </Border>
      </Grid>

      <!-- 參考稽核模式 -->
      <Grid x:Name="ReferenceAuditModeContentPanel"
            Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
          <Button x:Name="RunReferenceAuditButton"
                  Height="28" Padding="10,0" Margin="0,0,8,0"
                  Style="{StaticResource SmallButtonStyle}"
                  Click="RunReferenceAuditButton_OnClick">
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE896;" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
              <TextBlock Text="開始稽核" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button x:Name="ExportReferenceAuditButton"
                  Height="28" Padding="10,0" Margin="0,0,12,0"
                  Style="{StaticResource SmallButtonStyle}"
                  Click="ExportReferenceAuditButton_OnClick"
                  IsEnabled="False">
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8DE;" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
              <TextBlock Text="匯出稽核 xlsx" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <CheckBox x:Name="ReferenceAuditIncludeDrawingsCheckBox"
                    Content="同資料夾搜尋工程圖 (.slddrw)"
                    VerticalAlignment="Center"
                    ToolTip="於每個引用到的 .sldprt／.sldasm 所在資料夾尋找同名工程圖並列入表。" />
          <TextBlock Text="（使用上方同一個組合件路徑）"
                     VerticalAlignment="Center"
                     Foreground="DimGray"
                     Margin="10,0,0,0" />
        </WrapPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
          <TextBlock Text="最大層數：" VerticalAlignment="Center" Foreground="DimGray" />
          <TextBox x:Name="ReferenceAuditMaxDepthTextBox"
                   Width="50" Height="26" Text="3"
                   Margin="6,0,0,0" VerticalContentAlignment="Center" />
          <CheckBox x:Name="ReferenceAuditAllDepthCheckBox"
                    Content="取所有層"
                    Margin="10,0,16,0" VerticalAlignment="Center"
                    IsChecked="False"
                    Checked="DepthAllCheckBox_OnCheckedChanged"
                    Unchecked="DepthAllCheckBox_OnCheckedChanged" />
          <TextBlock Text="預覽篩選：" VerticalAlignment="Center" Margin="0,0,6,0" />
          <ComboBox x:Name="ReferenceAuditPreviewFilterComboBox"
                    MinWidth="260" Width="300" Height="26"
                    VerticalContentAlignment="Center"
                    SelectionChanged="ReferenceAuditPreviewFilterComboBox_OnSelectionChanged">
            <ComboBoxItem Content="全部顯示" IsSelected="True" />
            <ComboBoxItem Content="僅 Vault 根目錄內（IsUnderVaultRoot）" />
            <ComboBoxItem Content="僅非 Vault 根目錄下" />
            <ComboBoxItem Content="僅檔案不存在（路徑無效或遺失）" />
            <ComboBoxItem Content="僅 S:\ 資料夾（路徑在 S 槽下）" />
            <ComboBoxItem Content="僅非 S:\（不含 S 槽路徑）" />
            <ComboBoxItem Content="僅工程圖列（.slddrw）" />
            <ComboBoxItem Content="排除工程圖列" />
          </ComboBox>
          <TextBlock x:Name="ReferenceAuditPreviewCountTextBlock"
                     Margin="12,0,0,0" VerticalAlignment="Center"
                     Foreground="DimGray" FontSize="12" Text="預覽：—" />
        </StackPanel>

        <TextBlock Grid.Row="2"
                   Margin="0,0,0,6"
                   FontSize="11"
                   Foreground="DimGray"
                   TextWrapping="Wrap"
                   Text="以 SolidWorks API 遞迴展開單一 .sldasm（可為 Vault 外路徑）。可選「同資料夾搜尋工程圖」以加入同名 .slddrw。「在 Vault 內」以 C:\CP-PDM 為判斷根目錄。匯出稽核 xlsx 僅包含「目前預覽篩選後」的列。請在本機已安裝 SolidWorks 下執行。" />

        <Border Grid.Row="3"
                BorderBrush="#FFE5E7EB"
                BorderThickness="1"
                CornerRadius="8"
                ClipToBounds="True">
          <DataGrid x:Name="ReferenceAuditDataGrid"
                    MinHeight="160"
                    IsReadOnly="True"
                    AutoGenerateColumns="True"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    SelectionMode="Extended"
                    HeadersVisibility="Column"
                    GridLinesVisibility="All"
                    HorizontalGridLinesBrush="#FFE5E7EB"
                    VerticalGridLinesBrush="#FFE5E7EB"
                    AlternationCount="2"
                    EnableRowVirtualization="True"
                    BorderThickness="0"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.VerticalScrollBarVisibility="Auto" />
        </Border>
      </Grid>
    </Grid>

    <!-- ══════════════════════════════════════════════
         Row 5 — 狀態列（狀態文字 + 進度列）
    ══════════════════════════════════════════════ -->
    <Border Grid.Row="5"
            Background="#FFF3F4F6"
            BorderBrush="#FFE5E7EB"
            BorderThickness="1"
            CornerRadius="8"
            Margin="12,6,12,8"
            Padding="12,5">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="200" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="StatusTextBlock"
                   Grid.Column="0"
                   VerticalAlignment="Center"
                   TextWrapping="NoWrap"
                   TextTrimming="CharacterEllipsis"
                   Foreground="#FF6B7280"
                   FontSize="12"
                   Text="就緒" />

        <TextBlock x:Name="BomConfigStatusTextBlock"
                   Grid.Column="1"
                   VerticalAlignment="Center"
                   FontSize="11"
                   Foreground="DimGray"
                   Margin="12,0,12,0"
                   TextWrapping="NoWrap" />

        <StackPanel x:Name="MainProgressPanel"
                    Grid.Column="2"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">
          <ProgressBar x:Name="ProgressBar"
                       Width="160"
                       Height="10"
                       Minimum="0"
                       Maximum="100"
                       VerticalAlignment="Center" />
          <TextBlock x:Name="ProgressPercentTextBlock"
                     Text="0%"
                     Width="36"
                     Margin="6,0,0,0"
                     VerticalAlignment="Center"
                     TextAlignment="Right"
                     Foreground="DimGray"
                     FontSize="11" />
        </StackPanel>
      </Grid>
    </Border>

  </Grid>
</Window>
