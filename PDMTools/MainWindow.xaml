<Window x:Class="PDMTools.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PDMTools - BOM Exporter"
        Height="560"
        Width="920"
        MinHeight="400"
        MinWidth="720"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style x:Key="FilterHeaderButtonStyle" TargetType="Button">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Padding" Value="2,0,2,0" />
      <Setter Property="Margin" Value="4,0,0,0" />
      <Setter Property="Height" Value="18" />
      <Setter Property="MinWidth" Value="18" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

    <Style x:Key="BomDataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="ContentTemplate">
        <Setter.Value>
          <DataTemplate>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0"
                         Text="{Binding Title}"
                         VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" />
              <Button Grid.Column="1"
                      Tag="{Binding Key}"
                      Click="ColumnFilterButton_OnClick">
                <Button.Content>
                  <TextBlock FontFamily="Segoe MDL2 Assets"
                             Text="&#xE71C;"
                             FontSize="11" />
                </Button.Content>
                <Button.Style>
                  <Style BasedOn="{StaticResource FilterHeaderButtonStyle}" TargetType="Button">
                    <Setter Property="Foreground" Value="DimGray" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsFiltered}" Value="True">
                        <Setter Property="Foreground" Value="#FF1565C0" />
                        <Setter Property="FontWeight" Value="Bold" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
              </Button>
            </Grid>
          </DataTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" MinHeight="120" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>

    <TextBlock Grid.Row="0"
               Grid.ColumnSpan="2"
               Margin="0,0,0,8"
               Text="請先指定組合件 (.sldasm) 路徑，再於下方選擇作業模式：Vault BOM（會載入組態）或參考稽核。" />

    <TextBox x:Name="AssemblyPathTextBox"
             Grid.Row="1"
             Grid.Column="0"
             Height="30"
             Margin="0,0,8,0"
             VerticalContentAlignment="Center"
             TextChanged="AssemblyPathTextBox_OnTextChanged" />

    <Button x:Name="BrowseButton"
            Grid.Row="1"
            Grid.Column="1"
            Width="96"
            Height="30"
            Content="導入文件"
            Click="BrowseButton_OnClick" />

    <StackPanel Grid.Row="2"
                Grid.ColumnSpan="2"
                Margin="0,10,0,0"
                Orientation="Horizontal">
      <TextBlock Text="作業模式："
                 VerticalAlignment="Center"
                 Foreground="DimGray"
                 Margin="0,0,8,0" />
      <RadioButton x:Name="BomModeRadioButton"
                   Content="Vault BOM"
                   IsChecked="True"
                   GroupName="MainMode"
                   VerticalAlignment="Center"
                   Checked="MainModeRadioButton_OnChecked" />
      <RadioButton x:Name="ReferenceAuditModeRadioButton"
                   Content="參考稽核"
                   GroupName="MainMode"
                   Margin="16,0,0,0"
                   VerticalAlignment="Center"
                   Checked="MainModeRadioButton_OnChecked" />
    </StackPanel>

    <WrapPanel x:Name="BomOperationsPanel"
               Grid.Row="3"
                Grid.ColumnSpan="2"
                Margin="0,14,0,0"
                Orientation="Horizontal">
      <Button x:Name="StartGrabButton"
              Width="120"
              Height="32"
              Content="開始抓取"
              Click="StartGrabButton_OnClick" />
      <Button x:Name="ExportButton"
              Width="120"
              Height="32"
              Margin="10,0,0,0"
              Content="匯出 xlsx"
              Click="ExportButton_OnClick" />
      <Button x:Name="ColumnSettingsButton"
              Width="120"
              Height="32"
              Margin="10,0,0,0"
              Content="設定欄位..."
              Click="ColumnSettingsButton_OnClick" />
      <Button x:Name="ClearFiltersButton"
              Width="120"
              Height="32"
              Margin="10,0,0,0"
              Content="清除篩選"
              Click="ClearFiltersButton_OnClick"
              IsEnabled="False" />
      <ComboBox x:Name="BomLevelDefinitionComboBox"
                Width="160"
                Height="32"
                Margin="10,0,0,0"
                SelectedIndex="1"
                VerticalContentAlignment="Center">
        <ComboBoxItem Content="定義A（含根）" />
        <ComboBoxItem Content="定義B（不含根）" />
      </ComboBox>

      <TextBlock Text="組態："
                 Margin="10,0,0,0"
                 VerticalAlignment="Center"
                 Foreground="DimGray" />
      <ComboBox x:Name="ConfigComboBox"
                Width="220"
                MinWidth="180"
                Height="32"
                Margin="6,0,0,0"
                IsEditable="False"
                IsTextSearchEnabled="True"
                VerticalContentAlignment="Center"
                ToolTip="選檔後由 PDM 讀取該組合件的組態清單（以 Vault 最新版為準）。預設會優先選取文件作用中組態；若 PDM 無法提供則依「預設」／Default 等備援。" />

      <TextBlock Text="最大層數："
                 Margin="10,0,0,0"
                 VerticalAlignment="Center"
                 Foreground="DimGray" />
      <TextBox x:Name="MaxBomDepthTextBox"
               Width="60"
               Height="30"
               Text="3"
               Margin="6,0,0,0"
               VerticalContentAlignment="Center" />
      <CheckBox x:Name="AllBomDepthCheckBox"
                 Content="取所有層"
                 Margin="10,0,0,0"
                 VerticalAlignment="Center"
                 IsChecked="False" />

      <ToggleButton x:Name="ShowDrawingsToggle"
                    Width="120"
                    Height="32"
                    Margin="10,0,0,0"
                    Content="顯示工程圖"
                    IsEnabled="False"
                    Click="ShowDrawingsToggle_Click" />
      <!-- 作業進度：百分比固定顯示在列條右側（不隨填滿區移動） -->
      <StackPanel Margin="12,4,0,0"
                  VerticalAlignment="Top"
                  Orientation="Vertical">
        <TextBlock Text="作業進度"
                   FontSize="11"
                   Foreground="DimGray"
                   Margin="0,0,0,4" />
        <Grid MinWidth="260">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="180" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ProgressBar x:Name="ProgressBar"
                       Grid.Column="0"
                       Height="20"
                       Minimum="0"
                       Maximum="100"
                       VerticalAlignment="Center" />
          <TextBlock x:Name="ProgressPercentTextBlock"
                     Grid.Column="1"
                     Text="0%"
                     Width="42"
                     Margin="10,0,0,0"
                     VerticalAlignment="Center"
                     TextAlignment="Right"
                     Foreground="DimGray"
                     FontSize="12" />
        </Grid>
      </StackPanel>
    </WrapPanel>

    <TextBlock x:Name="StatusTextBlock"
               Grid.Row="4"
               Grid.ColumnSpan="2"
               Margin="0,10,0,8"
               TextWrapping="Wrap"
               Foreground="DimGray"
               Text="就緒" />

    <Grid Grid.Row="5"
          Grid.ColumnSpan="2"
          MinHeight="200"
          Margin="0,0,0,0">
      <Grid x:Name="BomModeContentPanel"
            Visibility="Visible">
        <DataGrid x:Name="BomDataGrid"
                  MinHeight="200"
                  Margin="0,4,0,0"
                  IsReadOnly="True"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Extended"
                  HeadersVisibility="Column"
                  GridLinesVisibility="All"
                  HorizontalGridLinesBrush="#FFD8D8D8"
                  VerticalGridLinesBrush="#FFD8D8D8"
                  AlternationCount="2"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="True"
                  ColumnHeaderStyle="{StaticResource BomDataGridColumnHeaderStyle}"
                  PreviewMouseRightButtonDown="BomDataGrid_OnPreviewMouseRightButtonDown"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  ScrollViewer.CanContentScroll="True">
          <!--
            勿同時使用 AlternatingRowBackground：其會在自訂 RowStyle 之後套用，灰底會蓋掉工程圖藍底。
            改以 AlternationCount + Trigger 手動做白／灰交錯，並把 IsDrawing 的 DataTrigger 放在最後（同屬性以較後者為準）。
          -->
          <DataGrid.RowStyle>
            <Style TargetType="DataGridRow">
              <Setter Property="Background" Value="White" />
              <Style.Triggers>
                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                  <Setter Property="Background" Value="#FFF5F5F5" />
                </Trigger>
                <DataTrigger Binding="{Binding IsDrawing}" Value="True">
                  <Setter Property="Background" Value="#FFD6EEFF" />
                  <Setter Property="Foreground" Value="#FF003070" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </DataGrid.RowStyle>
          <DataGrid.ContextMenu>
            <ContextMenu>
              <MenuItem Header="複製儲存格"
                        Click="CopyCurrentCellMenuItem_OnClick" />
              <MenuItem Header="選取文字模式"
                        Click="OpenTextSelectionModeMenuItem_OnClick" />
            </ContextMenu>
          </DataGrid.ContextMenu>
        </DataGrid>
      </Grid>
      <Grid x:Name="ReferenceAuditModeContentPanel"
            Visibility="Collapsed"
            Margin="0,4,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <WrapPanel Grid.Row="0" Orientation="Horizontal">
            <Button x:Name="RunReferenceAuditButton"
                    Width="96"
                    Height="28"
                    Margin="0,0,0,0"
                    Content="開始稽核"
                    Click="RunReferenceAuditButton_OnClick" />
            <Button x:Name="ExportReferenceAuditButton"
                    Width="120"
                    Height="28"
                    Margin="10,0,0,0"
                    Content="匯出稽核 xlsx"
                    Click="ExportReferenceAuditButton_OnClick"
                    IsEnabled="False" />
            <TextBlock Text="（使用上方同一個組合件路徑）"
                       VerticalAlignment="Center"
                       Foreground="DimGray"
                       Margin="10,0,0,0" />
          </WrapPanel>
          <StackPanel Grid.Row="1"
                      Orientation="Horizontal"
                      Margin="0,8,0,4">
            <TextBlock Text="預覽篩選："
                       VerticalAlignment="Center"
                       Margin="0,0,8,0" />
            <ComboBox x:Name="ReferenceAuditPreviewFilterComboBox"
                      MinWidth="280"
                      Width="320"
                      Height="28"
                      VerticalContentAlignment="Center"
                      SelectionChanged="ReferenceAuditPreviewFilterComboBox_OnSelectionChanged">
              <ComboBoxItem Content="全部顯示"
                            IsSelected="True" />
              <ComboBoxItem Content="僅 Vault 根目錄內（IsUnderVaultRoot）" />
              <ComboBoxItem Content="僅非 Vault 根目錄下" />
              <ComboBoxItem Content="僅檔案不存在（路徑無效或遺失）" />
              <ComboBoxItem Content="僅 S:\ 資料夾（路徑在 S 槽下）" />
              <ComboBoxItem Content="僅非 S:\（不含 S 槽路徑）" />
            </ComboBox>
            <TextBlock x:Name="ReferenceAuditPreviewCountTextBlock"
                       Margin="14,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="DimGray"
                       FontSize="12"
                       Text="預覽：—" />
          </StackPanel>
          <TextBlock Grid.Row="2"
                     Margin="0,0,0,6"
                     FontSize="11"
                     Foreground="DimGray"
                     TextWrapping="Wrap"
                     Text="以 SolidWorks API 遞迴展開單一 .sldasm（可為 Vault 外路徑）。「在 Vault 內」以 C:\CP-PDM 為判斷根目錄；預覽可篩選（含 S:\ 路徑）。匯出稽核 xlsx 僅包含「目前預覽篩選後」的列。請在本機已安裝 SolidWorks 下執行。" />
          <DataGrid x:Name="ReferenceAuditDataGrid"
                    Grid.Row="3"
                    MinHeight="160"
                    Margin="0,0,0,0"
                    IsReadOnly="True"
                    AutoGenerateColumns="True"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    SelectionMode="Extended"
                    HeadersVisibility="Column"
                    GridLinesVisibility="All"
                    HorizontalGridLinesBrush="#FFD8D8D8"
                    VerticalGridLinesBrush="#FFD8D8D8"
                    AlternationCount="2"
                    EnableRowVirtualization="True"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.VerticalScrollBarVisibility="Auto" />
      </Grid>
    </Grid>
  </Grid>
</Window>
