<Window x:Class="PDMTools.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PDMTools - BOM Exporter"
        Height="560"
        Width="920"
        MinHeight="400"
        MinWidth="720"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style x:Key="FilterHeaderButtonStyle" TargetType="Button">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Padding" Value="2,0,2,0" />
      <Setter Property="Margin" Value="4,0,0,0" />
      <Setter Property="Height" Value="18" />
      <Setter Property="MinWidth" Value="18" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

    <Style x:Key="BomDataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="ContentTemplate">
        <Setter.Value>
          <DataTemplate>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0"
                         Text="{Binding Title}"
                         VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" />
              <Button Grid.Column="1"
                      Tag="{Binding Key}"
                      Click="ColumnFilterButton_OnClick">
                <Button.Content>
                  <TextBlock FontFamily="Segoe MDL2 Assets"
                             Text="&#xE71C;"
                             FontSize="11" />
                </Button.Content>
                <Button.Style>
                  <Style BasedOn="{StaticResource FilterHeaderButtonStyle}" TargetType="Button">
                    <Setter Property="Foreground" Value="DimGray" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsFiltered}" Value="True">
                        <Setter Property="Foreground" Value="#FF1565C0" />
                        <Setter Property="FontWeight" Value="Bold" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
              </Button>
            </Grid>
          </DataTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" MinHeight="120" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>

    <TextBlock Grid.Row="0"
               Grid.ColumnSpan="3"
               Margin="0,0,0,8"
               Text="請先指定組合件 (.sldasm) 路徑，再於下方選擇作業模式：Vault BOM（會載入組態）或參考稽核。" />

    <TextBox x:Name="AssemblyPathTextBox"
             Grid.Row="1"
             Grid.Column="0"
             Height="30"
             Margin="0,0,8,0"
             VerticalContentAlignment="Center"
             TextChanged="AssemblyPathTextBox_OnTextChanged" />

    <Button x:Name="BrowseButton"
            Grid.Row="1"
            Grid.Column="1"
            Width="96"
            Height="30"
            Content="導入文件"
            Click="BrowseButton_OnClick" />

    <Button x:Name="RecentPathsButton"
            Grid.Row="1"
            Grid.Column="2"
            Width="96"
            Height="30"
            Margin="8,0,0,0"
            Content="最近使用"
            Click="RecentPathsButton_OnClick" />

    <StackPanel Grid.Row="2"
                Grid.ColumnSpan="3"
                Margin="0,10,0,0"
                Orientation="Horizontal">
      <TextBlock Text="作業模式："
                 VerticalAlignment="Center"
                 Foreground="DimGray"
                 Margin="0,0,8,0" />
      <RadioButton x:Name="BomModeRadioButton"
                   Content="Vault BOM"
                   IsChecked="True"
                   GroupName="MainMode"
                   VerticalAlignment="Center"
                   Checked="MainModeRadioButton_OnChecked" />
      <RadioButton x:Name="ReferenceAuditModeRadioButton"
                   Content="參考稽核"
                   GroupName="MainMode"
                   Margin="16,0,0,0"
                   VerticalAlignment="Center"
                   Checked="MainModeRadioButton_OnChecked" />
      <Button x:Name="SaveProjectButton"
              Width="110"
              Height="28"
              Margin="24,0,0,0"
              Content="儲存專案快照…"
              Click="SaveProjectButton_OnClick"
              ToolTip="將目前畫面上的路徑、模式、表格資料與篩選狀態存成 JSON。預設儲存至程式目錄下的 PdmSnapshots 資料夾；檔名含組合件主檔名、模式標籤（VaultBom 或 RefAudit）與本機時間。" />
      <Button x:Name="LoadProjectButton"
              Width="110"
              Height="28"
              Margin="8,0,0,0"
              Content="開啟專案快照…"
              Click="LoadProjectButton_OnClick"
              ToolTip="從 JSON 快照還原畫面（不需重新向 Vault／SolidWorks 抓取）。預設開啟程式目錄下的 PdmSnapshots 資料夾。" />
    </StackPanel>

    <WrapPanel x:Name="BomOperationsPanel"
               Grid.Row="3"
                Grid.ColumnSpan="3"
                Margin="0,14,0,0"
                Orientation="Horizontal">
      <Button x:Name="StartGrabButton"
              Width="120"
              Height="32"
              Content="開始抓取"
              Click="StartGrabButton_OnClick" />
      <TextBlock x:Name="BomConfigStatusTextBlock"
                 MinWidth="120"
                 MaxWidth="280"
                 Margin="10,0,0,0"
                 VerticalAlignment="Center"
                 FontSize="11"
                 TextWrapping="Wrap"
                 Foreground="DimGray"
                 Text="" />
      <Button x:Name="ExportButton"
              Width="120"
              Height="32"
              Margin="10,0,0,0"
              Content="匯出 xlsx"
              Click="ExportButton_OnClick" />
      <Button x:Name="ColumnSettingsButton"
              Width="120"
              Height="32"
              Margin="10,0,0,0"
              Content="設定欄位..."
              Click="ColumnSettingsButton_OnClick" />
      <Button x:Name="CompareIgpBomButton"
              Width="140"
              Height="32"
              Margin="10,0,0,0"
              Content="比對 iGP BOM…"
              Click="CompareIgpBomButton_OnClick"
              ToolTip="匯入 iGP BOM（BOMMI02.xlsx／.xlsm／.csv）與目前 Vault BOM（依右側「比對階數」之深度上限、排除工程圖列）做差異比對（Stage1/Stage2）。建議優先使用從 iGP 直接匯出的 .xlsx 以避免 CSV 編碼問題。" />
      <Button x:Name="BatchDrawingPdfButton"
              Width="150"
              Height="32"
              Margin="10,0,0,0"
              Content="工程圖匯出 PDF…"
              Click="BatchDrawingPdfButton_OnClick"
              ToolTip="僅處理目前 DataGrid 篩選後可見之工程圖列：取檔、重建、匯出 PDF 至指定資料夾。" />
      <Button x:Name="CustomPropTemplateButton"
              Width="170"
              Height="32"
              Margin="10,0,0,0"
              Content="查詢自訂屬性範本…"
              Click="CustomPropTemplateButton_OnClick"
              ToolTip="查詢目前 DataGrid 篩選後可見之 SolidWorks 檔案所套用的自訂屬性範本（CustomPropertyBuilderTemplate）。" />
      <Button x:Name="DrawingSheetFormatButton"
              Width="170"
              Height="32"
              Margin="10,0,0,0"
              Content="查詢圖頁格式路徑…"
              Click="DrawingSheetFormatButton_OnClick"
              ToolTip="僅工程圖：查詢各圖頁格式路徑（GetTemplateName）；可勾選列後套用 .slddrt（check out、SetTemplateName、存檔）。" />
      <TextBlock Text="比對階數"
                 Margin="10,0,0,0"
                 VerticalAlignment="Center"
                 Foreground="DimGray" />
      <ComboBox x:Name="IgpBomCompareDepthComboBox"
                Width="72"
                Height="32"
                Margin="6,0,0,0"
                SelectedIndex="1"
                VerticalContentAlignment="Center"
                ToolTip="比對時納入的階層深度上限（2～4 階）。根階仍不參與比對鍵，僅供上下文顯示。">
        <ComboBoxItem Tag="2" Content="2 階" />
        <ComboBoxItem Tag="3" Content="3 階" />
        <ComboBoxItem Tag="4" Content="4 階" />
      </ComboBox>
      <Button x:Name="ClearFiltersButton"
              Width="120"
              Height="32"
              Margin="10,0,0,0"
              Content="清除篩選"
              Click="ClearFiltersButton_OnClick"
              IsEnabled="False" />
      <ComboBox x:Name="BomLevelDefinitionComboBox"
                Width="160"
                Height="32"
                Margin="10,0,0,0"
                SelectedIndex="1"
                SelectionChanged="BomLevelDefinitionComboBox_OnSelectionChanged"
                VerticalContentAlignment="Center">
        <ComboBoxItem Content="定義A（含根）" />
        <ComboBoxItem Content="定義B（不含根）" />
      </ComboBox>

      <TextBlock Text="組態："
                 Margin="10,0,0,0"
                 VerticalAlignment="Center"
                 Foreground="DimGray" />
      <ComboBox x:Name="ConfigComboBox"
                Width="220"
                MinWidth="180"
                Height="32"
                Margin="6,0,0,0"
                IsEditable="True"
                IsTextSearchEnabled="True"
                VerticalContentAlignment="Center"
                SelectionChanged="ConfigComboBox_SelectionOrTextChanged"
                ToolTip="選檔後由 PDM 讀取組態清單；可從清單選取，或在清單載入失敗時直接輸入組態名稱。預設會優先選取文件作用中組態。" />
      <Button x:Name="ReloadConfigurationsButton"
              Width="108"
              Height="32"
              Margin="8,0,0,0"
              Content="重新載入組態"
              Click="ReloadConfigurationsButton_OnClick"
              ToolTip="依目前路徑向 PDM 重新讀取組態清單；若仍失敗可改用手動輸入組態名稱。" />

      <TextBlock Text="最大層數："
                 Margin="10,0,0,0"
                 VerticalAlignment="Center"
                 Foreground="DimGray" />
      <TextBox x:Name="MaxBomDepthTextBox"
               Width="60"
               Height="30"
               Text="3"
               Margin="6,0,0,0"
               VerticalContentAlignment="Center" />
      <CheckBox x:Name="AllBomDepthCheckBox"
                 Content="取所有層"
                 Margin="10,0,0,0"
                 VerticalAlignment="Center"
                 IsChecked="False"
                 Checked="DepthAllCheckBox_OnCheckedChanged"
                 Unchecked="DepthAllCheckBox_OnCheckedChanged" />

      <ToggleButton x:Name="ShowDrawingsToggle"
                    Width="120"
                    Height="32"
                    Margin="10,0,0,0"
                    Content="顯示工程圖"
                    IsEnabled="False"
                    Click="ShowDrawingsToggle_Click" />
      <!-- 作業進度：百分比固定顯示在列條右側（不隨填滿區移動） -->
      <StackPanel Margin="12,4,0,0"
                  VerticalAlignment="Top"
                  Orientation="Vertical">
        <TextBlock Text="作業進度"
                   FontSize="11"
                   Foreground="DimGray"
                   Margin="0,0,0,4" />
        <Grid MinWidth="260">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="180" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ProgressBar x:Name="ProgressBar"
                       Grid.Column="0"
                       Height="20"
                       Minimum="0"
                       Maximum="100"
                       VerticalAlignment="Center" />
          <TextBlock x:Name="ProgressPercentTextBlock"
                     Grid.Column="1"
                     Text="0%"
                     Width="42"
                     Margin="10,0,0,0"
                     VerticalAlignment="Center"
                     TextAlignment="Right"
                     Foreground="DimGray"
                     FontSize="12" />
        </Grid>
      </StackPanel>
    </WrapPanel>

    <TextBlock x:Name="StatusTextBlock"
               Grid.Row="4"
               Grid.ColumnSpan="3"
               Margin="0,10,0,8"
               TextWrapping="Wrap"
               Foreground="DimGray"
               Text="就緒" />

    <Grid Grid.Row="5"
          Grid.ColumnSpan="3"
          MinHeight="200"
          Margin="0,0,0,0">
      <Grid x:Name="BomModeContentPanel"
            Visibility="Visible">
        <DataGrid x:Name="BomDataGrid"
                  MinHeight="200"
                  Margin="0,4,0,0"
                  IsReadOnly="True"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Extended"
                  HeadersVisibility="Column"
                  GridLinesVisibility="All"
                  HorizontalGridLinesBrush="#FFD8D8D8"
                  VerticalGridLinesBrush="#FFD8D8D8"
                  AlternationCount="2"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="True"
                  ColumnHeaderStyle="{StaticResource BomDataGridColumnHeaderStyle}"
                  Sorting="BomDataGrid_OnSorting"
                  PreviewMouseRightButtonDown="BomDataGrid_OnPreviewMouseRightButtonDown"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  ScrollViewer.CanContentScroll="True">
          <!--
            勿同時使用 AlternatingRowBackground：其會在自訂 RowStyle 之後套用，灰底會蓋掉工程圖藍底。
            改以 AlternationCount + Trigger 手動做白／灰交錯，並把 IsDrawing 的 DataTrigger 放在最後（同屬性以較後者為準）。
          -->
          <DataGrid.RowStyle>
            <Style TargetType="DataGridRow">
              <Setter Property="Background" Value="White" />
              <Style.Triggers>
                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                  <Setter Property="Background" Value="#FFF5F5F5" />
                </Trigger>
                <DataTrigger Binding="{Binding IsDrawing}" Value="True">
                  <Setter Property="Background" Value="#FFD6EEFF" />
                  <Setter Property="Foreground" Value="#FF003070" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </DataGrid.RowStyle>
          <DataGrid.ContextMenu>
            <ContextMenu>
              <MenuItem Header="複製儲存格"
                        Click="CopyCurrentCellMenuItem_OnClick" />
              <MenuItem Header="選取文字模式"
                        Click="OpenTextSelectionModeMenuItem_OnClick" />
            </ContextMenu>
          </DataGrid.ContextMenu>
        </DataGrid>
      </Grid>
      <Grid x:Name="ReferenceAuditModeContentPanel"
            Visibility="Collapsed"
            Margin="0,4,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <WrapPanel Grid.Row="0" Orientation="Horizontal">
            <Button x:Name="RunReferenceAuditButton"
                    Width="96"
                    Height="28"
                    Margin="0,0,0,0"
                    Content="開始稽核"
                    Click="RunReferenceAuditButton_OnClick" />
            <Button x:Name="ExportReferenceAuditButton"
                    Width="120"
                    Height="28"
                    Margin="10,0,0,0"
                    Content="匯出稽核 xlsx"
                    Click="ExportReferenceAuditButton_OnClick"
                    IsEnabled="False" />
            <CheckBox x:Name="ReferenceAuditIncludeDrawingsCheckBox"
                      Content="同資料夾搜尋工程圖 (.slddrw)"
                      Margin="12,0,0,0"
                      VerticalAlignment="Center"
                      ToolTip="於每個引用到的 .sldprt／.sldasm 所在資料夾尋找同名工程圖並列入表（與 Vault BOM 工程圖搜尋「同資料夾」階段相同；不含 PDM 全庫搜尋）。" />
            <TextBlock Text="（使用上方同一個組合件路徑）"
                       VerticalAlignment="Center"
                       Foreground="DimGray"
                       Margin="10,0,0,0" />
          </WrapPanel>
          <StackPanel Grid.Row="1"
                      Orientation="Horizontal"
                      Margin="0,8,0,4">
            <TextBlock Text="最大層數："
                       VerticalAlignment="Center"
                       Foreground="DimGray" />
            <TextBox x:Name="ReferenceAuditMaxDepthTextBox"
                     Width="60"
                     Height="28"
                     Text="3"
                     Margin="6,0,0,0"
                     VerticalContentAlignment="Center" />
            <CheckBox x:Name="ReferenceAuditAllDepthCheckBox"
                      Content="取所有層"
                      Margin="10,0,14,0"
                      VerticalAlignment="Center"
                      IsChecked="False"
                      Checked="DepthAllCheckBox_OnCheckedChanged"
                      Unchecked="DepthAllCheckBox_OnCheckedChanged" />
            <TextBlock Text="預覽篩選："
                       VerticalAlignment="Center"
                       Margin="0,0,8,0" />
            <ComboBox x:Name="ReferenceAuditPreviewFilterComboBox"
                      MinWidth="280"
                      Width="320"
                      Height="28"
                      VerticalContentAlignment="Center"
                      SelectionChanged="ReferenceAuditPreviewFilterComboBox_OnSelectionChanged">
              <ComboBoxItem Content="全部顯示"
                            IsSelected="True" />
              <ComboBoxItem Content="僅 Vault 根目錄內（IsUnderVaultRoot）" />
              <ComboBoxItem Content="僅非 Vault 根目錄下" />
              <ComboBoxItem Content="僅檔案不存在（路徑無效或遺失）" />
              <ComboBoxItem Content="僅 S:\ 資料夾（路徑在 S 槽下）" />
              <ComboBoxItem Content="僅非 S:\（不含 S 槽路徑）" />
              <ComboBoxItem Content="僅工程圖列（.slddrw）" />
              <ComboBoxItem Content="排除工程圖列" />
            </ComboBox>
            <TextBlock x:Name="ReferenceAuditPreviewCountTextBlock"
                       Margin="14,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="DimGray"
                       FontSize="12"
                       Text="預覽：—" />
          </StackPanel>
          <TextBlock Grid.Row="2"
                     Margin="0,0,0,6"
                     FontSize="11"
                     Foreground="DimGray"
                     TextWrapping="Wrap"
                     Text="以 SolidWorks API 遞迴展開單一 .sldasm（可為 Vault 外路徑）。可選「同資料夾搜尋工程圖」以加入同名 .slddrw。「在 Vault 內」以 C:\CP-PDM 為判斷根目錄；預覽可篩選（含 S:\ 路徑）。匯出稽核 xlsx 僅包含「目前預覽篩選後」的列。請在本機已安裝 SolidWorks 下執行。" />
          <DataGrid x:Name="ReferenceAuditDataGrid"
                    Grid.Row="3"
                    MinHeight="160"
                    Margin="0,0,0,0"
                    IsReadOnly="True"
                    AutoGenerateColumns="True"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    SelectionMode="Extended"
                    HeadersVisibility="Column"
                    GridLinesVisibility="All"
                    HorizontalGridLinesBrush="#FFD8D8D8"
                    VerticalGridLinesBrush="#FFD8D8D8"
                    AlternationCount="2"
                    EnableRowVirtualization="True"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.VerticalScrollBarVisibility="Auto" />
      </Grid>
    </Grid>
  </Grid>
</Window>
