<Window x:Class="PDMTools.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PDMTools - BOM Exporter"
        Height="560"
        Width="920"
        MinHeight="400"
        MinWidth="720"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" MinHeight="120" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>

    <TextBlock Grid.Row="0"
               Grid.ColumnSpan="2"
               Margin="0,0,0,8"
               Text="請選擇 C:\CP-PDM 底下的組合件 (.sldasm)。選檔後會載入該檔的組態清單，請從「組態」下拉選取（不需手動輸入名稱）。" />

    <TextBox x:Name="AssemblyPathTextBox"
             Grid.Row="1"
             Grid.Column="0"
             Height="30"
             Margin="0,0,8,0"
             VerticalContentAlignment="Center"
             IsReadOnly="True" />

    <Button x:Name="BrowseButton"
            Grid.Row="1"
            Grid.Column="1"
            Width="88"
            Height="30"
            Content="瀏覽"
            Click="BrowseButton_OnClick" />

    <WrapPanel Grid.Row="2"
                Grid.ColumnSpan="2"
                Margin="0,14,0,0"
                Orientation="Horizontal">
      <Button x:Name="StartGrabButton"
              Width="120"
              Height="32"
              Content="開始抓取"
              Click="StartGrabButton_OnClick" />
      <Button x:Name="ExportButton"
              Width="120"
              Height="32"
              Margin="10,0,0,0"
              Content="匯出 xlsx"
              Click="ExportButton_OnClick" />
      <Button x:Name="ColumnSettingsButton"
              Width="120"
              Height="32"
              Margin="10,0,0,0"
              Content="設定欄位..."
              Click="ColumnSettingsButton_OnClick" />
      <ComboBox x:Name="BomLevelDefinitionComboBox"
                Width="160"
                Height="32"
                Margin="10,0,0,0"
                SelectedIndex="1"
                VerticalContentAlignment="Center">
        <ComboBoxItem Content="定義A（含根）" />
        <ComboBoxItem Content="定義B（不含根）" />
      </ComboBox>

      <TextBlock Text="組態："
                 Margin="10,0,0,0"
                 VerticalAlignment="Center"
                 Foreground="DimGray" />
      <ComboBox x:Name="ConfigComboBox"
                Width="220"
                MinWidth="180"
                Height="32"
                Margin="6,0,0,0"
                IsEditable="False"
                IsTextSearchEnabled="True"
                VerticalContentAlignment="Center"
                ToolTip="選檔後由 PDM 讀取該組合件的組態清單（以 Vault 最新版為準）。預設會優先選取文件作用中組態；若 PDM 無法提供則依「預設」／Default 等備援。" />

      <TextBlock Text="最大層數："
                 Margin="10,0,0,0"
                 VerticalAlignment="Center"
                 Foreground="DimGray" />
      <TextBox x:Name="MaxBomDepthTextBox"
               Width="60"
               Height="30"
               Text="3"
               Margin="6,0,0,0"
               VerticalContentAlignment="Center" />
      <CheckBox x:Name="AllBomDepthCheckBox"
                 Content="取所有層"
                 Margin="10,0,0,0"
                 VerticalAlignment="Center"
                 IsChecked="False" />

      <ToggleButton x:Name="ShowDrawingsToggle"
                    Width="120"
                    Height="32"
                    Margin="10,0,0,0"
                    Content="顯示工程圖"
                    IsEnabled="False"
                    Click="ShowDrawingsToggle_Click" />
      <!-- 作業進度：百分比固定顯示在列條右側（不隨填滿區移動） -->
      <StackPanel Margin="12,4,0,0"
                  VerticalAlignment="Top"
                  Orientation="Vertical">
        <TextBlock Text="作業進度"
                   FontSize="11"
                   Foreground="DimGray"
                   Margin="0,0,0,4" />
        <Grid MinWidth="260">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="180" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ProgressBar x:Name="ProgressBar"
                       Grid.Column="0"
                       Height="20"
                       Minimum="0"
                       Maximum="100"
                       VerticalAlignment="Center" />
          <TextBlock x:Name="ProgressPercentTextBlock"
                     Grid.Column="1"
                     Text="0%"
                     Width="42"
                     Margin="10,0,0,0"
                     VerticalAlignment="Center"
                     TextAlignment="Right"
                     Foreground="DimGray"
                     FontSize="12" />
        </Grid>
      </StackPanel>
    </WrapPanel>

    <TextBlock x:Name="StatusTextBlock"
               Grid.Row="3"
               Grid.ColumnSpan="2"
               Margin="0,10,0,8"
               TextWrapping="Wrap"
               Foreground="DimGray"
               Text="就緒" />

    <!-- 欄位多時以橫向捲軸瀏覽；列多時以縱向捲軸（DataGrid 內建） -->
    <DataGrid x:Name="BomDataGrid"
              Grid.Row="4"
              Grid.ColumnSpan="2"
              MinHeight="200"
              Margin="0,0,0,0"
              IsReadOnly="True"
              AutoGenerateColumns="False"
              CanUserAddRows="False"
              CanUserDeleteRows="False"
              SelectionMode="Extended"
              HeadersVisibility="Column"
              GridLinesVisibility="All"
              HorizontalGridLinesBrush="#FFD8D8D8"
              VerticalGridLinesBrush="#FFD8D8D8"
              AlternationCount="2"
              EnableRowVirtualization="True"
              EnableColumnVirtualization="True"
              ScrollViewer.HorizontalScrollBarVisibility="Auto"
              ScrollViewer.VerticalScrollBarVisibility="Auto"
              ScrollViewer.CanContentScroll="True">
      <!--
        勿同時使用 AlternatingRowBackground：其會在自訂 RowStyle 之後套用，灰底會蓋掉工程圖藍底。
        改以 AlternationCount + Trigger 手動做白／灰交錯，並把 IsDrawing 的 DataTrigger 放在最後（同屬性以較後者為準）。
      -->
      <DataGrid.RowStyle>
        <Style TargetType="DataGridRow">
          <Setter Property="Background" Value="White" />
          <Style.Triggers>
            <Trigger Property="ItemsControl.AlternationIndex" Value="1">
              <Setter Property="Background" Value="#FFF5F5F5" />
            </Trigger>
            <DataTrigger Binding="{Binding IsDrawing}" Value="True">
              <Setter Property="Background" Value="#FFD6EEFF" />
              <Setter Property="Foreground" Value="#FF003070" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </DataGrid.RowStyle>
      <!-- 欄位於程式碼中建立，與 Excel 匯出一致 -->
    </DataGrid>
  </Grid>
</Window>
