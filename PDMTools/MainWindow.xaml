<Window x:Class="PDMTools.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PDMTools - BOM Exporter"
        Height="260"
        Width="760"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>

    <TextBlock Grid.Row="0"
               Grid.ColumnSpan="2"
               Margin="0,0,0,8"
               Text="請選擇 C:\CP-PDM 底下的組合件 (.sldasm)" />

    <TextBox x:Name="AssemblyPathTextBox"
             Grid.Row="1"
             Grid.Column="0"
             Height="30"
             Margin="0,0,8,0"
             VerticalContentAlignment="Center"
             IsReadOnly="True" />

    <Button x:Name="BrowseButton"
            Grid.Row="1"
            Grid.Column="1"
            Width="88"
            Height="30"
            Content="瀏覽"
            Click="BrowseButton_OnClick" />

    <StackPanel Grid.Row="2"
                Grid.ColumnSpan="2"
                Margin="0,14,0,0"
                Orientation="Horizontal">
      <Button x:Name="ExportButton"
              Width="120"
              Height="32"
              Content="執行匯出"
              Click="ExportButton_OnClick" />
      <ProgressBar x:Name="ProgressBar"
                   Width="380"
                   Height="20"
                   Margin="12,6,0,0"
                   Minimum="0"
                   Maximum="100" />
    </StackPanel>

    <TextBlock x:Name="StatusTextBlock"
               Grid.Row="3"
               Grid.ColumnSpan="2"
               Margin="0,14,0,0"
               TextWrapping="Wrap"
               Foreground="DimGray"
               Text="就緒" />
  </Grid>
</Window>
