<Window x:Class="PDMTools.CustomPropertyTemplateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="自訂屬性範本查詢"
        Height="560"
        Width="860"
        MinHeight="400"
        MinWidth="640"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" MinHeight="180" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock x:Name="SummaryTextBlock"
               Grid.Row="0"
               Margin="0,0,0,10"
               TextWrapping="Wrap"
               Foreground="DimGray" />

    <StackPanel Grid.Row="1"
                Orientation="Horizontal"
                Margin="0,0,0,8">
      <Button x:Name="StartButton"
              Width="100"
              Height="30"
              Content="開始查詢"
              Click="Start_OnClick" />
      <Button x:Name="CancelButton"
              Width="100"
              Height="30"
              Margin="10,0,0,0"
              Content="取消"
              IsEnabled="False"
              Click="Cancel_OnClick" />
      <ProgressBar x:Name="BatchProgressBar"
                   Width="220"
                   Height="22"
                   Margin="16,0,0,0"
                   Minimum="0"
                   Maximum="100"
                   Value="0" />
      <TextBlock x:Name="ProgressText"
                 Margin="10,0,0,0"
                 VerticalAlignment="Center"
                 Foreground="DimGray" />
    </StackPanel>

    <DataGrid x:Name="ResultDataGrid"
              Grid.Row="2"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              CanUserSortColumns="True"
              CanUserReorderColumns="True"
              CanUserResizeColumns="True"
              HeadersVisibility="Column"
              GridLinesVisibility="Horizontal"
              AlternatingRowBackground="#F7F7F7"
              FontSize="12"
              SelectionMode="Single">
      <DataGrid.Columns>
        <DataGridTextColumn Header="檔名"
                            Binding="{Binding FileName}"
                            Width="180" />
        <DataGridTextColumn Header="副檔名"
                            Binding="{Binding Extension}"
                            Width="70" />
        <DataGridTextColumn Header="範本名稱"
                            Binding="{Binding TemplateName}"
                            Width="180" />
        <DataGridTextColumn Header="範本完整路徑"
                            Binding="{Binding TemplatePath}"
                            Width="*" />
        <DataGridTextColumn Header="焊件範本名"
                            Binding="{Binding WeldmentTemplateName}"
                            Width="140" />
        <DataGridTextColumn Header="焊件範本路徑"
                            Binding="{Binding WeldmentTemplatePath}"
                            Width="200" />
        <DataGridTextColumn Header="狀態"
                            Binding="{Binding Status}"
                            Width="60" />
        <DataGridTextColumn Header="訊息"
                            Binding="{Binding Message}"
                            Width="200" />
      </DataGrid.Columns>
    </DataGrid>

    <TextBlock x:Name="FooterTextBlock"
               Grid.Row="3"
               Margin="0,8,0,0"
               Foreground="DimGray"
               FontSize="11"
               TextWrapping="Wrap" />
  </Grid>
</Window>
