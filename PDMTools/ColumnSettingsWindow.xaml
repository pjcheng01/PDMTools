<Window x:Class="PDMTools.ColumnSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="設定顯示欄位"
        Width="460" Height="640"
        MinWidth="340" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 說明文字 -->
        <TextBlock Grid.Row="0" Margin="0,0,0,10"
                   Text="勾選要在表格與 Excel 中顯示的欄位（重新抓取後生效）："
                   TextWrapping="Wrap" FontSize="12"/>

        <!-- 全選 / 全不選（作用於所有欄位） -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="全選"   Width="72" Height="26" Click="SelectAll_Click"  Margin="0,0,8,0"/>
            <Button Content="全不選" Width="72" Height="26" Click="SelectNone_Click" Margin="0,0,16,0"/>
            <TextBlock x:Name="CountText" VerticalAlignment="Center" Foreground="DimGray" FontSize="11"/>
        </StackPanel>

        <!-- 欄位清單（固定 + 資料卡分區） -->
        <Border Grid.Row="2" BorderBrush="#FFCCCCCC" BorderThickness="1" CornerRadius="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="6,6,6,6">

                    <!-- ─── 固定欄位區 ─────────────────────────────── -->
                    <TextBlock Text="固定欄位  （Level 欄固定顯示，不列於此）"
                               FontWeight="SemiBold" FontSize="11"
                               Foreground="#FF444444"
                               Margin="2,0,2,4"/>
                    <StackPanel x:Name="FixedColumnPanel"/>

                    <!-- 分隔線 -->
                    <Separator Margin="0,10,0,10" Background="#FFDDDDDD"/>

                    <!-- ─── 資料卡變數區 ───────────────────────────── -->
                    <TextBlock Text="資料卡變數  （由 Vault 偵測）"
                               FontWeight="SemiBold" FontSize="11"
                               Foreground="#FF444444"
                               Margin="2,0,2,4"/>
                    <StackPanel x:Name="VariablePanel"/>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 狀態 -->
        <TextBlock x:Name="StatusText" Grid.Row="3"
                   Margin="0,8,0,0" Foreground="DimGray"
                   TextWrapping="Wrap" FontSize="11"/>

        <!-- OK / 取消 -->
        <StackPanel Grid.Row="4" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="確定" Width="88" Height="30"
                    Margin="0,0,10,0" IsDefault="True" Click="OK_Click"/>
            <Button Content="取消" Width="88" Height="30"
                    IsCancel="True" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
