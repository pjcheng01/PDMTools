<Window x:Class="PDMTools.ColumnSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="設定顯示欄位"
        Width="720" Height="520"
        MinWidth="540" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <Window.Resources>
        <Style x:Key="TransferBtn" TargetType="Button">
            <Setter Property="Width"  Value="38"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,3"/>
        </Style>
        <Style x:Key="OrderBtn" TargetType="Button">
            <Setter Property="Width"  Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0" Header="欄位組合（Preset）" Padding="6" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="已儲存：" Foreground="DimGray"/>
                <ComboBox x:Name="ProfileCombo"
                          Grid.Row="0"
                          Grid.Column="1"
                          Height="28"
                          MinWidth="180"
                          VerticalContentAlignment="Center"
                          SelectionChanged="ProfileCombo_SelectionChanged"/>

                <TextBlock Grid.Row="0" Grid.Column="3" VerticalAlignment="Center" Text="名稱：" Foreground="DimGray"/>
                <TextBox x:Name="ProfileNameBox"
                         Grid.Row="0"
                         Grid.Column="4"
                         Height="28"
                         MinWidth="150"
                         VerticalContentAlignment="Center"/>

                <WrapPanel Grid.Row="1"
                           Grid.ColumnSpan="5"
                           Margin="0,8,0,0"
                           Orientation="Horizontal">
                    <Button Width="76"
                            Height="28"
                            Margin="0,0,6,0"
                            Content="儲存"
                            Click="SaveProfile_Click"/>
                    <Button Width="76"
                            Height="28"
                            Margin="0,0,6,0"
                            Content="套用"
                            Click="ApplyProfile_Click"/>
                    <Button Width="76"
                            Height="28"
                            Content="刪除"
                            Click="DeleteProfile_Click"/>
                </WrapPanel>
            </Grid>
        </GroupBox>

        <!-- 說明 -->
        <TextBlock Grid.Row="1" Margin="0,0,0,10" FontSize="12" TextWrapping="Wrap"
                   Text="從右側選取欄位加入左側；左側順序即為表格與 Excel 的欄位順序。（Level 欄固定顯示）"/>

        <!-- 主區域：左側已選 ─ 中間按鈕 ─ 右側可用 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── 左側：已選欄位 + 排序按鈕 ── -->
            <GroupBox Grid.Column="0" Header="已選欄位（顯示順序）" Padding="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ListBox x:Name="SelectedList"
                             Grid.Column="0"
                             SelectionMode="Extended"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             MouseDoubleClick="SelectedList_DoubleClick"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="5,0,0,0">
                        <Button Content="↑" Style="{StaticResource OrderBtn}"
                                Click="MoveUp_Click" ToolTip="上移"/>
                        <Button Content="↓" Style="{StaticResource OrderBtn}"
                                Click="MoveDown_Click" ToolTip="下移"/>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <!-- ── 中間：穿梭按鈕 ── -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
                <Button Style="{StaticResource TransferBtn}"
                        Content="←" Click="AddSelected_Click"
                        ToolTip="加入選取項目"/>
                <Button Style="{StaticResource TransferBtn}"
                        Content="«" Click="AddAll_Click"
                        ToolTip="全部加入"/>
                <Button Style="{StaticResource TransferBtn}"
                        Content="→" Margin="0,14,0,3" Click="RemoveSelected_Click"
                        ToolTip="移除選取項目"/>
                <Button Style="{StaticResource TransferBtn}"
                        Content="»" Click="RemoveAll_Click"
                        ToolTip="全部移除"/>
            </StackPanel>

            <!-- ── 右側：可用欄位 + 搜尋框 ── -->
            <GroupBox Grid.Column="2" Header="可用欄位" Padding="4">
                <DockPanel>
                    <TextBox x:Name="SearchBox"
                             DockPanel.Dock="Top"
                             Height="28" Margin="0,0,0,5"
                             VerticalContentAlignment="Center"
                             Text=""
                             TextChanged="SearchBox_TextChanged">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Style.Resources>
                                    <VisualBrush x:Key="Hint" Stretch="None" AlignmentX="Left" AlignmentY="Center">
                                        <VisualBrush.Visual>
                                            <TextBlock Text="搜尋..." Foreground="DarkGray" Margin="4,0"/>
                                        </VisualBrush.Visual>
                                    </VisualBrush>
                                </Style.Resources>
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Background" Value="{StaticResource Hint}"/>
                                    </Trigger>
                                    <Trigger Property="Text" Value="{x:Null}">
                                        <Setter Property="Background" Value="{StaticResource Hint}"/>
                                    </Trigger>
                                    <Trigger Property="IsFocused" Value="True">
                                        <Setter Property="Background" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <ListBox x:Name="AvailableList"
                             SelectionMode="Extended"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             MouseDoubleClick="AvailableList_DoubleClick"/>
                </DockPanel>
            </GroupBox>
        </Grid>

        <!-- 底部：計數 + 確定/取消 -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="CountText"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       Foreground="DimGray" FontSize="11"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="確定" Width="88" Height="30"
                        Margin="0,0,10,0" IsDefault="True" Click="OK_Click"/>
                <Button Content="取消" Width="88" Height="30"
                        IsCancel="True" Click="Cancel_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
